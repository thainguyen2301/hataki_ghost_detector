<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#676767"
                android:startColor="#363636"
                android:type="linear" />
            <corners android:radius="54dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="@color/primary"
                android:startColor="#7B0E00"
                android:type="linear" />
            <corners android:radius="54dp" />
        </shape>
    </item>
</layer-list>