<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black">

        <com.ghost.finder.detector.radar.tracker.ui.common.BackgroundCloseView
            android:id="@+id/bg_top"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_start_rada"
            app:layout_constraintBottom_toTopOf="@+id/divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/title"
            style="@style/CustomText_20_white_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fingerpaint_regular"
            android:gravity="center"
            android:text="@string/start_warning_message"
            android:textAllCaps="true"
            app:layout_constraintBottom_toBottomOf="@+id/bg_top"
            app:layout_constraintEnd_toEndOf="@+id/bg_top"
            app:layout_constraintStart_toStartOf="@+id/bg_top"
            app:layout_constraintTop_toTopOf="@+id/bg_top" />


        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/primary"
            app:layout_constraintBottom_toTopOf="@id/img_bg_bottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_bg_bottom"
            android:layout_width="0dp"
            android:layout_height="166dp"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_accept"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_accept"
            style="@style/CustomText_16_white_bold"
            android:layout_width="156dp"
            android:layout_height="48dp"
            android:background="@drawable/accept_button_gradient"
            android:text="@string/accept"
            app:layout_constraintBottom_toBottomOf="@+id/img_bg_bottom"
            app:layout_constraintEnd_toEndOf="@+id/img_bg_bottom"
            app:layout_constraintStart_toStartOf="@+id/img_bg_bottom"
            app:layout_constraintTop_toTopOf="@+id/img_bg_bottom" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>