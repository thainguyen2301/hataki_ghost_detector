<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_root"
        android:layout_width="96dp"
        android:layout_height="48dp"
        android:background="#363636"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:padding="6dp">

        <FrameLayout
            android:id="@+id/btn_off"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@color/green"
            android:clipToPadding="false"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/edge_button_off"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_left"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_circle_outline" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_on"
            android:layout_width="32dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@color/black"
            android:clipToPadding="false"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_off"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/ic_minus" />
        </FrameLayout>

        <View
            android:id="@+id/edge_button_off"
            android:layout_width="8dp"
            android:layout_height="40dp"
            android:background="#073006"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/edge_button_on"
            android:layout_width="8dp"
            android:layout_height="40dp"
            android:background="#073006"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_on"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</merge>
